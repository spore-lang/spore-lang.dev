---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { filterPostsByLocale } from "@/utils/blogContent";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { getSocials } from "@/constants";
import {
  getBlogCopy,
  getBlogLocaleFromPathname,
  localizePath,
} from "@/i18n/blog";

const locale = getBlogLocaleFromPathname(Astro.url.pathname);
const copy = getBlogCopy(locale);
const socials = getSocials(locale);
const posts = filterPostsByLocale(await getCollection("blog"), locale);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={localizePath("/", locale)}
    class="app-layout"
  >
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {SITE.title}
      </h1>
      <a
        target="_blank"
        href={localizePath("/rss.xml", locale)}
        class="inline-block"
        aria-label={copy.rssSubscribe}
        title={copy.rssSubscribe}
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">{copy.rssSubscribe}</span>
      </a>

      <p>{copy.siteDescription}</p>
      <p class="mt-2">
        {
          locale === "zh" ? (
            <>
              这里会逐步把 `vision`、`roadmap` 与 `implementation` 三组草稿扩写成正式文章。你也可以先从
              <LinkButton
                class="underline decoration-dashed underline-offset-4 hover:text-accent"
                href="https://spore-lang.dev/"
              >
                {copy.mainSite}
              </LinkButton>
              了解整体定位，或前往
              <LinkButton
                class="underline decoration-dashed underline-offset-4 hover:text-accent"
                href="https://docs.spore-lang.dev/"
              >
                {copy.docsSite}
              </LinkButton>
              查看当前语言状态。
            </>
          ) : (
            <>
              This space will publish the finalized `vision`, `roadmap`, and `implementation` essays in English. For the current drafts, start from the
              <LinkButton
                class="underline decoration-dashed underline-offset-4 hover:text-accent"
                href="https://spore-lang.dev/"
              >
                {copy.mainSite}
              </LinkButton>
              , or check the
              <LinkButton
                class="underline decoration-dashed underline-offset-4 hover:text-accent"
                href="https://docs.spore-lang.dev/"
              >
                {copy.docsSite}
              </LinkButton>
              .
            </>
          )
        }
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">{copy.relatedLinks}</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      sortedPosts.length === 0 && (
        <section id="upcoming-posts" class="pt-12 pb-6">
          <p class="text-lg leading-8 text-foreground/85">
            {
              locale === "en" ? (
                <>
                  {copy.englishEmptyHome}{" "}
                  <LinkButton
                    class="underline decoration-dashed underline-offset-4 hover:text-accent"
                    href={localizePath("/", "zh")}
                  >
                    {copy.browseChineseDrafts}
                  </LinkButton>
                  .
                </>
              ) : (
                copy.noPostsListing
              )
            }
          </p>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">{copy.featuredPosts}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">{copy.latestPosts}</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={localizePath("/posts", locale)}>
        {copy.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent = document.querySelector("#main-content") as HTMLElement;
    const indexLayout = mainContent?.dataset?.layout;
    const homePath = mainContent?.dataset?.homePath;
    if (indexLayout && homePath) {
      sessionStorage.setItem("backUrl", homePath);
    }
  });
</script>
