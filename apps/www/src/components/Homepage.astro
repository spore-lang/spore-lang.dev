---
import "../styles/fonts.css";
import {
  browserLocaleRedirectScript,
  homepageAlternateLinks,
  homepageCopyByLocale,
  homepagePathByLocale,
} from '../data/homepage-content';
import type { HomepageLocale } from '../data/homepage-content';

interface Props {
  locale: HomepageLocale;
  autoRedirect?: boolean;
}

const { locale, autoRedirect = false } = Astro.props;
const copy = homepageCopyByLocale[locale];
const canonicalUrl = `https://spore-lang.dev${homepagePathByLocale[locale]}`;
---

<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.pageTitle}</title>
    <meta name="description" content={copy.metaDescription} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource-variable/geist@5.2.8/wght.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/cn-fontsource-source-han-sans-sc-vf@1.0.10/font.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/maplemono-normal-nf-cn@1.0.0/regular.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/maplemono-normal-nf-cn@1.0.0/italic.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/iosevka@5.2.5/latin-400.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/iosevka@5.2.5/latin-400-italic.css"
    />
    <link rel="canonical" href={canonicalUrl} />
    {
      homepageAlternateLinks.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    {autoRedirect && <script is:inline>{browserLocaleRedirectScript}</script>}
  </head>
  <body>
    <main>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions">
        <a class="action primary" href={copy.primaryHref}>
          {copy.primaryAction}
        </a>
        <a class="action" href={copy.secondaryHref}>
          {copy.secondaryAction}
        </a>
      </div>

      <section class="grid">
        <article>
          <h2>{copy.splitTitle}</h2>
          <p>{copy.splitBody}</p>
        </article>
        <article>
          <h2>{copy.livesTitle}</h2>
          <p>{copy.livesBody}</p>
        </article>
        <article>
          <h2>{copy.sisterTitle}</h2>
          <p>{copy.sisterBody}</p>
        </article>
      </section>

      <section class="links">
        <a href="https://github.com/spore-lang/spore">github.com/spore-lang/spore</a>
        <a href="https://github.com/spore-lang/spore-evolution">github.com/spore-lang/spore-evolution</a>
        <a href={copy.docsLinkHref}>{copy.docsLinkLabel}</a>
      </section>
    </main>
  </body>
  <style>
    :root {
      color-scheme: dark;
      font-family: var(--font-ui);
      background: #0a0f17;
      color: #eef2ff;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at top, rgba(82, 140, 255, 0.18), transparent 35%),
        linear-gradient(180deg, #0a0f17 0%, #0f172a 100%);
    }

    main {
      width: min(1080px, calc(100% - 3rem));
      margin: 0 auto;
      padding: 5rem 0 6rem;
    }

    .eyebrow {
      margin: 0 0 1rem;
      color: #8fb3ff;
      font-size: 0.95rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(3rem, 8vw, 6rem);
      line-height: 0.92;
    }

    .lead {
      max-width: 42rem;
      margin: 1.25rem 0 0;
      color: #d7def7;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin: 2rem 0 0;
    }

    .action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.85rem 1.1rem;
      border: 1px solid rgba(143, 179, 255, 0.28);
      border-radius: 999px;
      color: #eef2ff;
      text-decoration: none;
      background: rgba(15, 23, 42, 0.72);
    }

    .action.primary {
      background: linear-gradient(135deg, #5f7cff, #8c66ff);
      border-color: transparent;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin: 3rem 0 0;
    }

    article {
      padding: 1.25rem;
      border: 1px solid rgba(143, 179, 255, 0.16);
      border-radius: 1rem;
      background: rgba(15, 23, 42, 0.74);
      backdrop-filter: blur(14px);
    }

    h2 {
      margin: 0 0 0.75rem;
      font-size: 1.1rem;
    }

    article p,
    .links a {
      color: #c7d2fe;
      line-height: 1.65;
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin: 2rem 0 0;
    }

    .links a {
      text-decoration: none;
    }

    .links a:hover,
    .action:hover {
      opacity: 0.92;
    }
  </style>
</html>
